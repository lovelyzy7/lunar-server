# 复制为 .env 后按需修改（docker compose 自动读取；Windows/Linux 通用，路径建议用正斜杠）。

# Docker 挂载的服务端检出目录（含 server/db、server/assets）。
# 标准布局（服务端就在本仓库内）保持 "." 即可；仅在服务端位于别处时才改为对应路径：
#   Linux/macOS: /path/to/lunar-server
#   Windows:     D:/path/to/lunar-server
LUNAR_SERVER_DIR=.
# 面板数据目录（设置、master data、补丁任务与备份）。
PANEL_DATA_DIR=./panel/data

# Go 模块代理（部分网络访问 proxy.golang.org 受限，可换镜像）。
# Mainland China example: https://goproxy.cn,direct
GOPROXY=https://goproxy.cn,direct

# Debian 软件源镜像（构建 panel 镜像时使用，留空=官方源）。
# 国内建议：mirrors.tuna.tsinghua.edu.cn 或 mirrors.aliyun.com
APT_MIRROR=mirrors.tuna.tsinghua.edu.cn

# 客户端连接地址（填宿主机局域网 IP 或域名）。
LUNAR_PUBLIC_ADDR=192.168.1.100:8003
LUNAR_PUBLIC_CDN=192.168.1.100:8080
# 游戏服务端下发给客户端的 CDN 地址（必须客户端可访问）。
LUNAR_OCTO_URL=http://192.168.1.100:8080

# 管理 webhook 令牌（强烈建议设置，用于热重载 master data）。
LUNAR_ADMIN_TOKEN=change-me

# 对外发布端口。
LUNAR_GRPC_PORT=8003
LUNAR_CDN_PORT=8080
LUNAR_AUTH_PORT=3000
LUNAR_ADMIN_PORT=8082
LUNAR_PANEL_PORT=8888

TZ=Asia/Shanghai
